---
import Layout from '../layouts/Layout.astro';
import RenovationCalculator from '../components/RenovationCalculator';
import { travauxData, getRelatedTravaux, type TravauxPageData } from '../lib/travaux-data';

export function getStaticPaths() {
  return travauxData.map((t) => ({
    params: { travaux: t.slug },
    props: { travaux: t },
  }));
}

interface Props {
  travaux: TravauxPageData;
}

const { travaux } = Astro.props;
const related = getRelatedTravaux(travaux.relatedSlugs);

const fmt = (n: number) => n.toLocaleString('fr-FR');

const uniteLabel = travaux.unite === 'par_m2' ? '/m²' : travaux.unite === 'par_fenetre' ? '/fenêtre' : '';

const categoriesMeta = [
  { key: 'bleu' as const, nom: 'Bleu', label: 'Très modestes', couleur: '#3b82f6', bg: 'bg-blue-50', text: 'text-blue-700', border: 'border-blue-200' },
  { key: 'jaune' as const, nom: 'Jaune', label: 'Modestes', couleur: '#eab308', bg: 'bg-yellow-50', text: 'text-yellow-700', border: 'border-yellow-200' },
  { key: 'violet' as const, nom: 'Violet', label: 'Intermédiaires', couleur: '#8b5cf6', bg: 'bg-purple-50', text: 'text-purple-700', border: 'border-purple-200' },
  { key: 'rose' as const, nom: 'Rose', label: 'Supérieurs', couleur: '#ec4899', bg: 'bg-pink-50', text: 'text-pink-700', border: 'border-pink-200' },
];

const categoryLabel = travaux.category === 'chauffage' ? 'Chauffage' : travaux.category === 'isolation' ? 'Isolation' : travaux.category === 'ventilation' ? 'Ventilation' : 'Autre';

const pageTitle = `Aide ${travaux.label} 2026 - MaPrimeRénov' et CEE`;
const pageDescription = `Montants MaPrimeRénov' 2026 et primes CEE pour ${travaux.label.toLowerCase()}. Barèmes par catégorie de revenus (Bleu, Jaune, Violet, Rose), conditions et simulation gratuite.`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://aide-renovation-calcul.fr/" },
    { "@type": "ListItem", "position": 2, "name": `Aide ${travaux.label}`, "item": `https://aide-renovation-calcul.fr/aide-${travaux.slug}/` },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": travaux.faq.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer },
  })),
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="space-y-10">
    <!-- Breadcrumb -->
    <nav aria-label="Fil d'Ariane" class="text-sm text-gray-500">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-primary transition-colors">Accueil</a></li>
        <li class="before:content-['/'] before:mx-1.5 before:text-gray-300">
          <span class="text-gray-700 font-medium">Aide {travaux.label}</span>
        </li>
      </ol>
    </nav>

    <!-- H1 + intro -->
    <div class="max-w-3xl">
      <div class="flex items-center gap-2 mb-3">
        <span class={`inline-block px-2.5 py-0.5 rounded-full text-xs font-medium ${
          travaux.category === 'chauffage' ? 'bg-red-100 text-red-700' :
          travaux.category === 'isolation' ? 'bg-amber-100 text-amber-700' :
          travaux.category === 'ventilation' ? 'bg-cyan-100 text-cyan-700' :
          'bg-gray-100 text-gray-700'
        }`}>
          {categoryLabel}
        </span>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        Aide {travaux.label} 2026
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed">
        {travaux.description}
      </p>
    </div>

    <!-- Tableau des montants -->
    <div class="bg-white rounded-xl shadow-sm border border-border p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">
        Montants des aides par catégorie de revenus
      </h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b-2 border-gray-200">
              <th class="text-left py-3 pr-4 font-semibold text-gray-700">Catégorie</th>
              <th class="text-right py-3 px-4 font-semibold text-gray-700">MaPrimeRénov'{uniteLabel}</th>
              <th class="text-right py-3 px-4 font-semibold text-gray-700">Prime CEE{uniteLabel}</th>
              <th class="text-right py-3 pl-4 font-semibold text-gray-700">Écrêtement</th>
            </tr>
          </thead>
          <tbody>
            {categoriesMeta.map((cat) => {
              const montant = travaux.montantMPR[cat.key];
              return (
                <tr class="border-b border-gray-100 hover:bg-gray-50">
                  <td class="py-3 pr-4">
                    <div class="flex items-center gap-2">
                      <div class="w-3 h-3 rounded-full" style={`background-color: ${cat.couleur}`} />
                      <div>
                        <span class="font-medium text-gray-800">{cat.nom}</span>
                        <span class="text-gray-500 text-xs ml-1">({cat.label})</span>
                      </div>
                    </div>
                  </td>
                  <td class="text-right py-3 px-4 font-semibold">
                    {montant !== null ? (
                      <span class="text-primary">{fmt(montant)} €</span>
                    ) : (
                      <span class="text-gray-400">Non éligible</span>
                    )}
                  </td>
                  <td class="text-right py-3 px-4 text-secondary">
                    {travaux.ceeBas > 0 ? `${fmt(travaux.ceeBas)} – ${fmt(travaux.ceeHaut)} €` : '-'}
                  </td>
                  <td class="text-right py-3 pl-4 text-gray-600">
                    {cat.key === 'bleu' ? '90 %' : cat.key === 'jaune' ? '75 %' : cat.key === 'violet' ? '60 %' : '40 %'}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-400 mt-4">
        Plafond de dépenses éligibles : {fmt(travaux.plafondDepenses)} €{uniteLabel} TTC.
        Les montants CEE sont des fourchettes indicatives qui varient selon le fournisseur d'énergie.
      </p>
    </div>

    <!-- Simulateur -->
    <div class="bg-green-50 rounded-xl border border-green-200 p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-2">
        Simulez vos aides pour {travaux.label.toLowerCase().startsWith('l') || travaux.label.toLowerCase().startsWith('a') || travaux.label.toLowerCase().startsWith('i') || travaux.label.toLowerCase().startsWith('u') ? "l'" : ''}{!travaux.label.toLowerCase().startsWith('l') && !travaux.label.toLowerCase().startsWith('a') && !travaux.label.toLowerCase().startsWith('i') && !travaux.label.toLowerCase().startsWith('u') ? travaux.label.toLowerCase() : travaux.label.toLowerCase().replace(/^(l'|l')/, '')}
      </h2>
      <p class="text-gray-600 mb-4">
        Utilisez notre simulateur gratuit pour calculer le montant exact de vos aides selon votre situation (revenus, composition du foyer, localisation) et obtenir une estimation personnalisée du reste à charge.
      </p>
    </div>
    <RenovationCalculator client:idle />

    <!-- Contenu éditorial -->
    <div class="prose prose-slate max-w-none">
      <h2>{travaux.label} : contexte et enjeux en 2026</h2>
      <p>{travaux.contexte}</p>

      <h2>Conditions d'éligibilité aux aides pour {travaux.label.toLowerCase()}</h2>
      <p>
        Pour bénéficier de MaPrimeRénov' et des primes CEE pour l'installation ou la réalisation de travaux de type
        {' '}{travaux.label.toLowerCase()}, plusieurs conditions doivent être réunies. Le logement doit être votre résidence
        principale, occupé au moins 8 mois par an, et achevé depuis plus de 15 ans (ou 2 ans si vous remplacez une
        chaudière au fioul ou au charbon). Vous devez être propriétaire occupant, propriétaire bailleur ou copropriétaire.
      </p>
      <p>
        Les travaux doivent impérativement être réalisés par un professionnel certifié RGE (Reconnu Garant de
        l'Environnement) dans le domaine de travaux concerné. La demande MaPrimeRénov' doit être déposée sur la
        plateforme <a href="https://www.maprimerenov.gouv.fr" target="_blank" rel="noopener noreferrer">maprimerenov.gouv.fr</a> avant
        le début des travaux. Le versement de la prime intervient après la réalisation des travaux, sur présentation
        de la facture de l'entreprise RGE.
      </p>
      <p>
        Les primes CEE (Certificats d'Économies d'Énergie) sont versées par les fournisseurs d'énergie
        (EDF, Engie, TotalEnergies, etc.) et doivent être demandées avant la signature du devis. Le montant varie
        selon le fournisseur : comparez les offres pour obtenir la meilleure prime. Les CEE sont cumulables avec
        MaPrimeRénov' dans la limite du taux d'écrêtement de votre catégorie de revenus.
      </p>

      <h2>Conseils pratiques</h2>
      <ul>
        {travaux.conseils.map((conseil) => (
          <li>{conseil}</li>
        ))}
      </ul>

      <h2>Comment financer le reste à charge ?</h2>
      <p>
        Après déduction de MaPrimeRénov' et des primes CEE, le reste à charge peut être financé par l'éco-prêt
        à taux zéro (éco-PTZ). Ce prêt sans intérêts est accessible sans conditions de ressources et permet
        d'emprunter jusqu'à 15 000 € pour un geste unique, 25 000 € pour deux gestes ou 30 000 € pour trois
        gestes et plus. La durée de remboursement maximale est de 20 ans. Depuis 2022, la notification
        d'attribution de MaPrimeRénov' vaut justificatif auprès de la banque pour obtenir l'éco-PTZ.
      </p>
      <p>
        La TVA réduite à 5,5 % s'applique automatiquement aux travaux de rénovation énergétique dans les
        logements de plus de 2 ans. Elle représente une économie supplémentaire significative, notamment sur
        les chantiers importants. Certaines collectivités locales proposent également des aides complémentaires
        (régions, départements, communes) : renseignez-vous auprès de votre espace conseil
        <a href="https://www.france-renov.gouv.fr" target="_blank" rel="noopener noreferrer">France Rénov'</a>.
      </p>

      <h2>Questions fréquentes</h2>
      {travaux.faq.map((f) => (
        <details>
          <summary><strong>{f.question}</strong></summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>

    <!-- Travaux liés -->
    {related.length > 0 && (
      <div class="bg-white rounded-xl shadow-sm border border-border p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Travaux complémentaires</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {related.map((r) => (
            <a
              href={`/aide-${r.slug}/`}
              class="block p-4 rounded-lg border border-gray-200 hover:border-primary hover:shadow-md transition-all"
            >
              <span class={`inline-block px-2 py-0.5 rounded-full text-xs font-medium mb-2 ${
                r.category === 'chauffage' ? 'bg-red-100 text-red-700' :
                r.category === 'isolation' ? 'bg-amber-100 text-amber-700' :
                r.category === 'ventilation' ? 'bg-cyan-100 text-cyan-700' :
                'bg-gray-100 text-gray-700'
              }`}>
                {r.category === 'chauffage' ? 'Chauffage' : r.category === 'isolation' ? 'Isolation' : r.category === 'ventilation' ? 'Ventilation' : 'Autre'}
              </span>
              <h3 class="font-semibold text-gray-900 text-sm mb-1">{r.label}</h3>
              <p class="text-xs text-gray-500">
                MPR : jusqu'à {fmt(Math.max(...Object.values(r.montantMPR).filter((v): v is number => v !== null)))} €{r.unite === 'par_m2' ? '/m²' : r.unite === 'par_fenetre' ? '/fenêtre' : ''}
              </p>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Liens guides -->
    <div class="bg-white rounded-xl shadow-sm border border-border p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Guides et ressources</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/guide-maprimerenov/" class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:border-primary hover:shadow-md transition-all">
          <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center text-primary shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          </div>
          <div>
            <span class="font-medium text-gray-900 text-sm">Guide MaPrimeRénov' 2026</span>
            <p class="text-xs text-gray-500">Barèmes, conditions, démarches</p>
          </div>
        </a>
        <a href="/guide-isolation/" class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:border-primary hover:shadow-md transition-all">
          <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center text-amber-600 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          </div>
          <div>
            <span class="font-medium text-gray-900 text-sm">Guide Isolation thermique</span>
            <p class="text-xs text-gray-500">Techniques, matériaux, performances</p>
          </div>
        </a>
        {categoriesMeta.map((cat) => (
          <a href={`/aides-renovation-${cat.key === 'bleu' ? 'tres-modeste' : cat.key === 'jaune' ? 'modeste' : cat.key === 'violet' ? 'intermediaire' : 'aises'}/`} class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:border-primary hover:shadow-md transition-all">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0" style={`background-color: ${cat.couleur}15`}>
              <div class="w-4 h-4 rounded-full" style={`background-color: ${cat.couleur}`} />
            </div>
            <div>
              <span class="font-medium text-gray-900 text-sm">Aides catégorie {cat.nom}</span>
              <p class="text-xs text-gray-500">Revenus {cat.label.toLowerCase()}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Sources -->
    <div class="border-t border-gray-200 pt-6 text-sm text-gray-500">
      <h2 class="font-semibold text-gray-700 mb-2">Sources officielles</h2>
      <ul class="space-y-1">
        <li>
          <a href="https://www.anah.gouv.fr" target="_blank" rel="noopener noreferrer" class="hover:text-primary">
            ANAH - Agence nationale de l'habitat (anah.gouv.fr)
          </a>
        </li>
        <li>
          <a href="https://www.maprimerenov.gouv.fr" target="_blank" rel="noopener noreferrer" class="hover:text-primary">
            MaPrimeRénov' - Plateforme officielle (maprimerenov.gouv.fr)
          </a>
        </li>
        <li>
          <a href="https://www.france-renov.gouv.fr" target="_blank" rel="noopener noreferrer" class="hover:text-primary">
            France Rénov' - Service public de la rénovation (france-renov.gouv.fr)
          </a>
        </li>
      </ul>
      <p class="mt-3 text-xs text-gray-400">
        Données basées sur les barèmes MaPrimeRénov' en vigueur au 1<sup>er</sup> janvier 2026. Les montants CEE sont des fourchettes indicatives.
        Ce site est indépendant et n'est pas affilié à l'ANAH ni au gouvernement.
      </p>
    </div>
  </div>
</Layout>
