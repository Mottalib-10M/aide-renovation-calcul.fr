    icon: "M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z",
    tag: "Stratégie"
  },
  {
    title: "Audit énergétique obligatoire",
    description: "Quand l'audit est requis, contenu, coût, financement et impact sur le DPE de votre logement.",
    href: "/guides/audit-energetique-obligatoire/",
    icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01",
    tag: "Diagnostic"
  }
];
---

<Layout
  title="Guides Rénovation Énergétique 2026 - Aides, Travaux et Démarches"
  description="Tous nos guides pratiques sur les aides à la rénovation énergétique : MaPrimeRénov', CEE, éco-PTZ, pompe à chaleur, isolation, artisans RGE, cumul des aides."
>
  <nav class="text-sm text-gray-500 mb-6" aria-label="Fil d'Ariane">
    <ol class="flex flex-wrap items-center gap-1">
      <li><a href="/" class="hover:text-primary">Accueil</a></li>
      <li class="before:content-['›'] before:mx-1">Guides</li>
    </ol>
  </nav>

  <div class="prose prose-slate max-w-none mb-10">
    <h1>Guides pratiques - Rénovation énergétique 2026</h1>
    <p class="lead text-lg text-gray-600">
      Découvrez nos guides complets pour comprendre toutes les aides à la rénovation énergétique,
      choisir les bons travaux et maximiser vos financements. Chaque guide détaille les conditions,
      les montants et les démarches à suivre.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    {guides.map((guide) => (
      <a
        href={guide.href}
        class="group flex flex-col bg-white border border-border rounded-xl p-6 hover:border-primary/40 hover:shadow-md transition-all"
      >
        <div class="flex items-start gap-4 mb-3">
          <div class="shrink-0 w-10 h-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d={guide.icon} />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-[11px] font-semibold uppercase tracking-wider text-primary bg-primary/10 px-2 py-0.5 rounded-full">{guide.tag}</span>
            </div>
            <h2 class="text-base font-bold text-gray-900 group-hover:text-primary transition-colors">{guide.title}</h2>
          </div>
        </div>
        <p class="text-sm text-gray-500 leading-relaxed">{guide.description}</p>
        <div class="mt-auto pt-4 text-sm font-medium text-primary flex items-center gap-1">
          Lire le guide
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </a>
    ))}
  </div>

  <div class="mt-12 bg-primary/5 border border-primary/20 rounded-xl p-6 text-center">
    <h2 class="text-lg font-bold text-gray-900 mb-2">Vous ne savez pas par où commencer ?</h2>
    <p class="text-gray-600 mb-4 max-w-xl mx-auto">
      Utilisez notre simulateur gratuit pour estimer le montant total des aides disponibles
      pour votre projet de rénovation.
    </p>
    <a href="/" class="inline-flex items-center gap-2 bg-primary text-white font-semibold px-6 py-2.5 rounded-lg hover:bg-primary-dark transition-colors">
      Simuler mes aides
    </a>
  </div>
</Layout>
