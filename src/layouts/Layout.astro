---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const siteUrl = 'https://aide-renovation-calcul.fr';
const pageUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Radif Partners" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="aide-renovation-calcul.fr" />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Schema.org WebApplication -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Simulateur Aides Rénovation Énergétique",
      "url": siteUrl,
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      },
      "description": description,
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Aide Renovation Calcul",
      "url": "https://aide-renovation-calcul.fr",
      "logo": "https://aide-renovation-calcul.fr/favicon.svg",
      "founder": {
        "@type": "Organization",
        "name": "Radif Partners"
      }
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Radif Partners",
      "jobTitle": "Financial Technology Expert",
      "url": "https://aide-renovation-calcul.fr"
    })} />

    <!-- Plausible Analytics -->
    <script defer data-domain="aide-renovation-calcul.fr" src="https://plausible.io/js/script.js"></script>

    <!-- TODO: Replace G-XXXXXXXXXX with your real GA4 Measurement ID from https://analytics.google.com -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>

  </head>
  <body class="min-h-screen bg-surface text-gray-900 font-sans">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:text-blue-700 focus:rounded-lg focus:shadow-lg focus:ring-2 focus:ring-blue-500">Skip to content</a>
    <header class="bg-white border-b border-border">
      <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-primary font-bold text-xl hover:text-primary-dark transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          aide-renovation-calcul.fr
        </a>

        <!-- Desktop nav -->
        <nav class="hidden md:flex items-center gap-6 text-sm">
          <a href="/" class="text-gray-600 hover:text-primary transition-colors">Simulateur</a>
          <a href="/guide-maprimerenov/" class="text-gray-600 hover:text-primary transition-colors">MaPrimeRénov'</a>
          <a href="/guide-isolation/" class="text-gray-600 hover:text-primary transition-colors">Isolation</a>
          <a href="/faq/" class="text-gray-600 hover:text-primary transition-colors">FAQ</a>
          <a href="/guides/" class="text-gray-600 hover:text-primary transition-colors">Guides</a>
        </nav>

        <!-- Mobile hamburger button -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg text-gray-600 hover:text-primary hover:bg-gray-100 transition-colors"
          aria-label="Ouvrir le menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Mobile nav -->
      <nav
        id="mobile-menu"
        class="hidden md:hidden border-t border-border bg-white"
      >
        <div class="max-w-5xl mx-auto px-4 py-4 flex flex-col gap-3 text-sm">
          <a href="/" class="flex items-center gap-2 py-2 px-3 rounded-lg text-gray-700 hover:text-primary hover:bg-gray-50 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
            Simulateur
          </a>
          <a href="/guide-maprimerenov/" class="flex items-center gap-2 py-2 px-3 rounded-lg text-gray-700 hover:text-primary hover:bg-gray-50 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            MaPrimeRénov'
          </a>
          <a href="/guide-isolation/" class="flex items-center gap-2 py-2 px-3 rounded-lg text-gray-700 hover:text-primary hover:bg-gray-50 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            Isolation
          </a>
          <a href="/faq/" class="flex items-center gap-2 py-2 px-3 rounded-lg text-gray-700 hover:text-primary hover:bg-gray-50 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            FAQ
          </a>
          <a href="/guides/" class="flex items-center gap-2 py-2 px-3 rounded-lg text-gray-700 hover:text-primary hover:bg-gray-50 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            Guides
          </a>
        </div>
      </nav>
    </header>

    <script is:inline>
      (function() {
        var btn = document.getElementById('mobile-menu-btn');
        var menu = document.getElementById('mobile-menu');
        var hamburger = document.getElementById('hamburger-icon');
        var closeIcon = document.getElementById('close-icon');
        if (btn && menu && hamburger && closeIcon) {
          btn.addEventListener('click', function() {
            var isOpen = !menu.classList.contains('hidden');
            if (isOpen) {
              menu.classList.add('hidden');
              hamburger.classList.remove('hidden');
              closeIcon.classList.add('hidden');
              btn.setAttribute('aria-expanded', 'false');
              btn.setAttribute('aria-label', 'Ouvrir le menu');
            } else {
              menu.classList.remove('hidden');
              hamburger.classList.add('hidden');
              closeIcon.classList.remove('hidden');
              btn.setAttribute('aria-expanded', 'true');
              btn.setAttribute('aria-label', 'Fermer le menu');
            }
          });
        }
      })();
    </script>

    <main id="main-content" class="max-w-5xl mx-auto px-4 py-8">
      <slot />
    </main>

    <footer class="bg-white border-t border-border mt-12">
      <div class="max-w-5xl mx-auto px-4 py-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-sm text-gray-600">
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Simulateurs & Guides</h3>
            <ul class="space-y-2">
              <li><a href="/" class="hover:text-primary">Cumul des aides rénovation</a></li>
              <li><a href="/guide-maprimerenov/" class="hover:text-primary">Guide MaPrimeRénov' 2026</a></li>
              <li><a href="/guide-isolation/" class="hover:text-primary">Guide Isolation thermique</a></li>
              <li><a href="/guides/" class="hover:text-primary">Tous les guides</a></li>
              <li><a href="/faq/" class="hover:text-primary">FAQ</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Ressources officielles</h3>
            <ul class="space-y-2">
              <li><a href="https://www.maprimerenov.gouv.fr" target="_blank" rel="noopener noreferrer" class="hover:text-primary">maprimerenov.gouv.fr</a></li>
              <li><a href="https://www.anah.gouv.fr" target="_blank" rel="noopener noreferrer" class="hover:text-primary">ANAH</a></li>
              <li><a href="https://www.france-renov.gouv.fr" target="_blank" rel="noopener noreferrer" class="hover:text-primary">France Rénov'</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Informations</h3>
            <ul class="space-y-2">
              <li><a href="/mentions-legales/" class="hover:text-primary">Mentions légales</a></li>
              <li><a href="/confidentialite/" class="hover:text-primary">Politique de confidentialité</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-8 pt-6 border-t border-gray-200">
          <h3 class="font-semibold text-gray-900 mb-3">Sites partenaires</h3>
          <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-600">
            <li><a href="https://fraisdenotaire-calcul.fr" target="_blank" rel="noopener" class="hover:text-primary">Frais de Notaire</a></li>
            <li><a href="https://assurance-emprunteur-eco.fr" target="_blank" rel="noopener" class="hover:text-primary">Assurance Emprunteur</a></li>
            <li><a href="https://cartegrisesimple.fr" target="_blank" rel="noopener" class="hover:text-primary">Carte Grise</a></li>
          </ul>
        </div>
        <div class="mt-8 pt-6 border-t border-gray-200 text-xs text-gray-400">
          <p>Simulateur gratuit et indépendant. Les résultats sont indicatifs et ne constituent pas un engagement de versement d'aides. Données basées sur les barèmes officiels 2026.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
